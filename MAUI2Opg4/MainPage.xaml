<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI2Opg4.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <CollectionView HeightRequest="300"
            x:Name="BilView" SelectionMode="Single"
            SelectionChanged="BilView_SelectionChanged"  >
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout>
                            <Label Text="{Binding Model}"/>
                        <Label Text="{Binding Heste}"/>
                        <CheckBox IsChecked="{Binding Elbil}"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Tilføj bil" Clicked="Button_Clicked"/>
            <Button Text="Ændre bil" Clicked="Button_Clicked_2"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
