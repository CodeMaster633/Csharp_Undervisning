<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiGUI.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Label
                Text="Administration"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Text="Vælg medarbejder: "
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <Picker x:Name="MedarbejderPicker"
                Title="Vælg medarbejder"
                SelectedIndexChanged="OnMedarbejderSelected">
            </Picker>
            
            <Label
                Text="Medarbejders tidsregistreringer: "
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <CollectionView x:Name="TidsregistreringCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label FontSize="20">
                            <Label.Text>
                                <MultiBinding StringFormat="Start: {0:yyyy-MM-dd HH:mm}, Slut: {1:yyyy-MM-dd HH:mm}">
                                    <Binding Path="StartTid" />
                                    <Binding Path="SlutTid" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="TimerUgeLabel"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
