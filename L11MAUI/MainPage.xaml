<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="L11MAUI.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                


            <Label x:Name="Lbl1" Grid.Row="0" 
           Grid.Column="0" 
           Text="Superman" 
           BackgroundColor="LightGreen"
                   MinimumWidthRequest="200"
           HorizontalOptions="Start" 
           VerticalOptions="Start" MinimumHeightRequest="200" />
                <Label x:Name="Lbl2" Grid.Row="0" 
           Grid.Column="2" 
           Text="Batman"            
                   BackgroundColor="LightGreen"
            MinimumWidthRequest="200" MinimumHeightRequest="200"
           HorizontalOptions="End" 
           VerticalOptions="Start" />

                <Label x:Name="Lbl3" Grid.Row="1"
            Grid.Column="0"
            Text="Abekat" MinimumWidthRequest="200" MinimumHeightRequest="200" AnchorX="100"
           BackgroundColor="LightGreen"
            HorizontalOptions="Start"
            VerticalOptions="Center" />
                <Label x:Name="Lbl4" Grid.Row="1"
            Grid.Column="2"
            Text="Elefant" MinimumWidthRequest="200" MinimumHeightRequest="200"
           BackgroundColor="LightGreen"
            HorizontalOptions="End"
            VerticalOptions="End" />


                <Button x:Name="BtnSwap1" Text="Swap 1" Clicked="BtnSwap1_Clicked" 
                        Grid.Row="0"
                Grid.Column="1"></Button>
                <Button x:Name="BtnSwap2" Text="Swap 1" Clicked="BtnSwap2_Clicked" 
                        Grid.Row="1"
                Grid.Column="1"></Button>

            </Grid>


