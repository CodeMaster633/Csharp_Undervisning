<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI2Opg1.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry x:Name="Model" Text="{Binding Path=Name}"/>
            <Entry x:Name="Heste" Text="{Binding Path=Heste}"/>
            <Entry x:Name="Elbil" Text="{Binding Path=Elbil}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
